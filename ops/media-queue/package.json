{
  "name": "zed-cafe-media-queue",
  "productName": "Zed Cafe Media Queue",
  "private": true,
  "version": "1.12.19",
  "main": "src/main.cjs",
  "description": "Electron media-queue helper for zed.cafe",
  "author": "zed.cafe",
  "license": "MIT",
  "scripts": {
    "fetch-binaries": "node scripts/fetch-binaries.mjs",
    "fetch-peerjs": "node scripts/fetch-peerjs.mjs",
    "verify-download": "node scripts/verify-download.mjs",
    "stage-electron-resources": "node scripts/stage-electron-resources.mjs",
    "prestart": "node scripts/fetch-peerjs.mjs && node scripts/fetch-binaries.mjs",
    "start": "node scripts/run-electron.mjs",
    "predist": "node scripts/fetch-peerjs.mjs && node scripts/fetch-binaries.mjs && node scripts/stage-electron-resources.mjs",
    "dist": "node scripts/run-builder.mjs",
    "dist:mac": "node scripts/run-builder.mjs --mac",
    "dist:win": "node scripts/run-builder.mjs --win"
  },
  "build": {
    "appId": "cafe.zed.media-queue",
    "productName": "Zed Cafe Media Queue",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "target": ["dmg"],
      "icon": "resources/icons/icon.png",
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": ["nsis"],
      "icon": "resources/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}

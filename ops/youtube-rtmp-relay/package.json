{
  "name": "zss-youtube-relay",
  "productName": "Zed Cafe YouTube Relay",
  "version": "1.11.60",
  "private": true,
  "main": "src/main.cjs",
  "description": "Local WHIP to YouTube RTMPS relay for zed.cafe (Electron)",
  "author": "zed.cafe",
  "license": "MIT",
  "scripts": {
    "prestart": "node scripts/fetch-binaries.mjs",
    "start": "node scripts/run-electron.mjs",
    "fetch-binaries": "node scripts/fetch-binaries.mjs",
    "stage-electron-resources": "node scripts/stage-electron-resources.mjs",
    "predist": "node scripts/fetch-binaries.mjs && node scripts/stage-electron-resources.mjs",
    "dist": "node scripts/run-builder.mjs",
    "dist:mac": "node scripts/run-builder.mjs --mac",
    "dist:win": "node scripts/run-builder.mjs --win"
  },
  "build": {
    "appId": "cafe.zed.youtube-relay",
    "productName": "Zed Cafe YouTube Relay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "target": ["dmg"],
      "icon": "resources/icons/icon.png",
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": ["nsis"],
      "icon": "resources/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zed Cafe YouTube Relay",
  "version": "1.11.60",
  "identifier": "cafe.zed.youtube-relay",
  "build": {
    "frontendDist": "../ui",
    "devUrl": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "zed.cafe YouTube relay",
        "width": 480,
        "height": 400,
        "resizable": false,
        "maximizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self'"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": ["../../vendor/**/*", "../../resources/fonts/**/*"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

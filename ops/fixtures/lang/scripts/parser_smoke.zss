' --- header stats (stmt_stat @...) ---
@object parsersmoke
@char 2
@color yellow
@bg black
@cycle 1
@ispushable
@score 0
'parser smoke: stats, labels, text, links, commands, blocks, exprs
' --- label ---
:start
' --- text / hyperlink ---
' quoted text line (leading ")
"Hello $yellowparser
' plain text (no leading statement marker)
plain text line
' hyperlink = words after ! until ; ; hyperlinktext = rest after ;
!lighttorch hk t;Torch
!message touch;Touch me
' --- short move ---
' short_go: blocking wait move/dir
/n
' short_try: non-blocking move/dir
?e
' --- simple commands ---
#set a 1
#set b 2
' paren expr + % term: (intround p1) % 4
#set p1 (intround p1) % 4
#clear mute
#go start
#send n calc
#play cdefg
#bgplay a
#idle
#char 1
#cycle 2
#put n red solid
#change red solid blue solid
#become object
#bind parsersmoke
#lock
#unlock
#zap start
#restore start
#give ammo 1
#take ammo 1
#shoot n
#throwstar n
#try n
#walk n
#endgame
' --- exprs / structured blocks ---
' comparison chain -> AND of pairwise compares (1<2 and 2<3)
#if 1 < 2 < 3
' pick token_expr inside if words
#if pick a b c
' newline allowed inside ( ... )
#if ( 1
+ 2 )
' expr: or binds loosest -> ((not a) and b) or c; do opens block until #done
#if not a and b or c do
 #set d 1
' else-if fork inside same open do block
#else if a is 0 do
 #set d 2
#else do
 #set d 3
#done
' else-if / else take / else forks share one do...#done
#if not isdark do
 #ticker no dark
#else if light do
 #ticker lit
' #else take = else + take command fork (not bare else)
#else take torches do
 #ticker no torches
#else do
 #set light 9
#done
' outer if do; nested duplicate block with its own else/done
#if 1 do
 ' nested command_if-style: duplicate by dirs, then else fork
 #duplicate by 1 0 by 0 0 do
  #bgplay a
 #else do
  #bgplay b
 #done
#done
' not eq is one isnoteq token (not unary not + eq)
#while p1 not eq 8 do
 ' inline if: words then inline command (no do)
 #if p1 is 0 push by -1 1 up
 #give p1
 #break
#done
#repeat 2 do
 #continue
#done
#foreach x in a b do
 #set y x
#done
' inline structured cmd ending in break (no do)
#while 1 break
#repeat 1 break
#if 1 break
' --- more labels / send / any ---
:calc
#send n calc
:calcdisplay
' any + dir + kind + trailing command words
#if any n line give p1 1
:drawdisplay
#end
#die

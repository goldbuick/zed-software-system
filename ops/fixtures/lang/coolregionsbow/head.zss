  #done
 #done
#done
#if p5 is 0 and p6 is 0 do
 #if p3 do
  #set p4 0
  #set p9 thisx
  #set p10 thisy
  #repeat 255 do
   #set p5 pget at p9 p10 p3
   #if not p5 break

  #if not p4 break
  #set p4 pget at p7 p8 p5
  #pset at p9 p10 p5 p7 - p4 - p9
  #set p4 pget at p7 p8 p6
  #pset at p9 p10 p6 p8 - p4 - p10
  #pset at p9 p10 p4 pget at p7 p8 id

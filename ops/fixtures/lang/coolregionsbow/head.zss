  #else if pget w id is p3 do
   #pset w p5 p5
   #pset w p6 p6
   #send w promote
  #done
 #done
 #send by p5 p6 shot
 #die
#else do
 #set p9 thisx
 #set p10 thisy
 #pset idle x p9 + p5
 #pset idle y p10 + p6
 #set p7 thisx
 #set p8 thisy
 #repeat 255 do
  #if not pget at p7 p8 p3 do
   #set p9 pget at p7 p8 p5
   #set p10 pget at p7 p8 p6
   #set p9 p7 - p9 - p9
   #set p10 p8 - p10 - p10
   #if any at p9 p10 segment do
    #if not pget at p9 p10 p4 do

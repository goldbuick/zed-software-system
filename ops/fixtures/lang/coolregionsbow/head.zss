   #pset at p9 p10 p4 p5
   #set p7 p9 - 1
   #set p8 p10
   #if pget at p7 p8 id is p5 do
   #else do
    #set p7 p9 + 1
    #if pget at p7 p8 id is p5 do
    #else do
     #set p7 p9
     #set p8 p10 - 1
     #if pget at p7 p8 id is p5 do
     #else do
      #set p8 p10 + 1
     #done
    #done
   #done
   #set p9 p7
   #set p10 p8
  #done
  #pset at p9 p10 p3 pget at p9 p10 p4
  #send at p9 p10 promote
  #set p5 0
  #set p6 0
  #set p7 0
  #morph segment
 #done
#else if any by p5 p6 player do
 #if p3 do
  #if pget n id is p3 do
   #pset n p5 p5
   #pset n p6 p6
   #send n promote
  #else if pget s id is p3 do
   #pset s p5 p5
   #pset s p6 p6
   #send s promote
  #else if pget e id is p3 do
   #pset e p5 p5
   #pset e p6 p6

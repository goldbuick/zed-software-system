@transporter
@cycle 2
@char 197
@shoot dir;Facing
:think
#set p2 intround currenttick / cycle
#if shootx do
 #set p1 shootx * 2 + 3
 #give p1 p2 % 4
 #if p1 is 0 char 40
 #if p1 is 1 char 60
 #if p1 is 2 char 40
 #if p1 is 3 char 179
 #if p1 is 4 char 41
 #if p1 is 5 char 62
 #if p1 is 6 char 41
 #if p1 is 7 char 179
#else if shooty do
 #set p1 shooty * 2 + 3
 #give p1 p2 % 4
 #if p1 is 0 char 94
 #if p1 is 1 char 126
 #if p1 is 2 char 94
 #if p1 is 3 char 45
 #if p1 is 4 char 118
 #if p1 is 5 char 95
 #if p1 is 6 char 118
 #if p1 is 7 char 45
#else do
 #char 197
#done
#idle
#think
:touch
:partytouch
#bgplay tc+d-e+f#-g#+a#c+d
#transport senderid
#think

#!/bin/sh
. /usr/lib/zedcafe/common.sh

while [ $# -gt 0 ]; do
  case "$1" in
    -r|--root)
      ZEDCAFE_ROOT=$2
      shift 2
      ;;
    -h|--help)
      zedcafe_usage "$0"
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

if ! zedcafe_requirestats; then
  exit 1
fi

echo "id	book	page	x	y	kind	path"
# Prefer board/objects placement (walkable coords). Paths look like:
#   <book>/<page>/board/objects/<id>.json
find "$ZEDCAFE_ROOT" -type f -path '*/board/objects/*.json' 2>/dev/null | sort | while read -r f; do
  rel=${f#"$ZEDCAFE_ROOT"/}
  book=$(printf '%s\n' "$rel" | cut -d/ -f1)
  page=$(printf '%s\n' "$rel" | cut -d/ -f2)
  jq -r --arg book "$book" --arg page "$page" --arg path "$rel" '
    (.id // "") as $id |
    (.kind // "") as $kind |
    ($path | split("/")[-1] | rtrimstr(".json")) as $fileid |
    select($kind == "player" or ($id | startswith("pid_")) or ($fileid | startswith("pid_"))) |
    [
      (if $id != "" then $id else $fileid end),
      $book,
      $page,
      (if .x == null then "" else (.x | floor | tostring) end),
      (if .y == null then "" else (.y | floor | tostring) end),
      $kind,
      $path
    ] | @tsv
  ' "$f"
done

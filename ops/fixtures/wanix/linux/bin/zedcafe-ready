#!/bin/sh
. /usr/lib/zedcafe/common.sh

while [ $# -gt 0 ]; do
  case "$1" in
    -r|--root)
      ZEDCAFE_ROOT=$2
      shift 2
      ;;
    -h|--help)
      zedcafe_usage "$0"
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

stats=$(zedcafe_statsfile)
deadline=$(($(date +%s) + ZEDCAFE_READY_TIMEOUT_SEC))

while [ "$(date +%s)" -lt "$deadline" ]; do
  if [ -s "$stats" ] && grep -q '"exportedAt"' "$stats" 2>/dev/null; then
    echo "ready: $ZEDCAFE_ROOT"
    exit 0
  fi
  sleep "$ZEDCAFE_READY_POLL_SEC"
done

echo "zedcafe-ready: timeout waiting for $stats" >&2
exit 1

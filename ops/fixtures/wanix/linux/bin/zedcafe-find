#!/bin/sh
. /usr/lib/zedcafe/common.sh

# ZZT / ZSS board width used to map flat terrain indices to (x, y).
BOARD_WIDTH=60

kind=
char=
name=
want_terrain=1
want_objects=1

while [ $# -gt 0 ]; do
  case "$1" in
    -r|--root)
      ZEDCAFE_ROOT=$2
      shift 2
      ;;
    --kind)
      kind=$2
      shift 2
      ;;
    --char)
      char=$2
      shift 2
      ;;
    --name)
      name=$2
      shift 2
      ;;
    --terrain-only)
      want_objects=0
      shift
      ;;
    --objects-only)
      want_terrain=0
      shift
      ;;
    -h|--help)
      cat >&2 <<'EOF'
usage: zedcafe-find [-r PATH] [--kind K] [--char N] [--name N]
                    [--terrain-only|--objects-only]

  Search all boards under /zedcafe for matching terrain cells and/or objects.
  At least one of --kind, --char, or --name is required (substring match for
  kind/name; exact number for char).
EOF
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

if [ -z "$kind" ] && [ -z "$char" ] && [ -z "$name" ]; then
  echo "zedcafe-find: need --kind and/or --char and/or --name" >&2
  echo "usage: zedcafe-find [--kind K] [--char N] [--name N]" >&2
  exit 1
fi

if ! zedcafe_requirestats; then
  exit 1
fi

echo "layer	book	page	id	x	y	kind	char	name	path"

match_jq='
  def matches:
    (if $kind == "" then true else ((.kind // "") | ascii_downcase | contains($kind | ascii_downcase)) end)
    and (if $char == "" then true else ((.char // null) | tostring) == $char end)
    and (if $name == "" then true else ((.name // "") | ascii_downcase | contains($name | ascii_downcase)) end);
'

if [ "$want_terrain" = 1 ]; then
  find "$ZEDCAFE_ROOT" -type f -path '*/board/terrain.json' 2>/dev/null | sort | while read -r f; do
    rel=${f#"$ZEDCAFE_ROOT"/}
    book=$(printf '%s\n' "$rel" | cut -d/ -f1)
    page=$(printf '%s\n' "$rel" | cut -d/ -f2)
    jq -r --arg book "$book" --arg page "$page" --arg path "$rel" \
      --arg kind "$kind" --arg char "$char" --arg name "$name" \
      --argjson width "$BOARD_WIDTH" \
      "$match_jq"'
      if type != "array" then empty else
        to_entries[] |
        select(.value != null and (.value | type == "object") and (.value | matches)) |
        [
          "terrain",
          $book,
          $page,
          "",
          (.key % $width | tostring),
          ((.key / $width) | floor | tostring),
          (.value.kind // ""),
          (if .value.char == null then "" else (.value.char | tostring) end),
          (.value.name // ""),
          $path
        ] | @tsv
      end
    ' "$f"
  done
fi

if [ "$want_objects" = 1 ]; then
  find "$ZEDCAFE_ROOT" -type f -path '*/board/objects/*.json' 2>/dev/null | sort | while read -r f; do
    rel=${f#"$ZEDCAFE_ROOT"/}
    book=$(printf '%s\n' "$rel" | cut -d/ -f1)
    page=$(printf '%s\n' "$rel" | cut -d/ -f2)
    fileid=$(printf '%s\n' "$rel" | sed 's|.*/||; s|\.json$||')
    jq -r --arg book "$book" --arg page "$page" --arg path "$rel" \
      --arg fileid "$fileid" \
      --arg kind "$kind" --arg char "$char" --arg name "$name" \
      "$match_jq"'
      select(type == "object" and matches) |
      [
        "object",
        $book,
        $page,
        (.id // $fileid),
        (if .x == null then "" else (.x | floor | tostring) end),
        (if .y == null then "" else (.y | floor | tostring) end),
        (.kind // ""),
        (if .char == null then "" else (.char | tostring) end),
        (.name // ""),
        $path
      ] | @tsv
    ' "$f"
  done
fi

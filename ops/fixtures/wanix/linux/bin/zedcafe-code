#!/bin/sh
. /usr/lib/zedcafe/common.sh

while [ $# -gt 0 ]; do
  case "$1" in
    -r|--root)
      ZEDCAFE_ROOT=$2
      shift 2
      ;;
    -h|--help)
      echo "usage: zedcafe-code [-r PATH] <pattern>" >&2
      echo "  Search page code fields under /zedcafe for a substring (case-insensitive)." >&2
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

pattern=$1
if [ -z "$pattern" ]; then
  echo "zedcafe-code: missing pattern" >&2
  echo "usage: zedcafe-code [-r PATH] <pattern>" >&2
  exit 1
fi

if ! zedcafe_requirestats; then
  exit 1
fi

echo "book	page	type	name	id	line	text"
# Page stats: <book>/<page>/stats.json (not root, book, or board stats).
find "$ZEDCAFE_ROOT" -type f -name 'stats.json' 2>/dev/null | sort | while read -r f; do
  rel=${f#"$ZEDCAFE_ROOT"/}
  # Exactly book/page/stats.json → two slashes.
  case "$rel" in
    */*/stats.json)
      case "$rel" in
        */*/board/stats.json|*/board/stats.json)
          continue
          ;;
      esac
      ;;
    *)
      continue
      ;;
  esac
  # Reject deeper paths (more than two directories).
  depth=$(printf '%s\n' "$rel" | awk -F/ '{print NF}')
  if [ "$depth" != 3 ]; then
    continue
  fi

  book=$(printf '%s\n' "$rel" | cut -d/ -f1)
  page=$(printf '%s\n' "$rel" | cut -d/ -f2)

  jq -r --arg book "$book" --arg page "$page" --arg pat "$pattern" '
    (.code // "") as $code |
    (.type // "") as $type |
    (.name // "") as $name |
    (.id // "") as $id |
    select(($code | ascii_downcase) | contains($pat | ascii_downcase)) |
    ($code | split("\n") | to_entries[] |
      select((.value | ascii_downcase) | contains($pat | ascii_downcase)) |
      [
        $book,
        $page,
        $type,
        $name,
        $id,
        (.key + 1 | tostring),
        .value
      ] | @tsv
    )
  ' "$f"
done
